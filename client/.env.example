# Which backend the client talks to: "supabase" (current) or "rest" (future self-hosted server)
REACT_APP_API_PROVIDER=supabase

# Supabase — bare project URL only (no /rest/v1/, no trailing slash)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# REST — base URL of the self-hosted API (see docs/api-contract.md)
REACT_APP_API_URL=http://localhost:4000/api
